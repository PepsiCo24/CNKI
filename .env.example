# CNKI Scholar AI — environment configuration
# Copy to .env and edit. Never commit real secrets.

# Data root (absolute path recommended). All papers, DB, exports live here.
CNKI_DATA_DIR=./data

# SQLite database URL. Leave empty to derive from CNKI_DATA_DIR.
CNKI_DATABASE_URL=

# Backend bind
CNKI_HOST=127.0.0.1
CNKI_PORT=8000

# Frontend dev server port (vite) — informational, set in frontend/.env
CNKI_FRONTEND_PORT=5173

# CORS origins (comma separated)
CNKI_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Log level
CNKI_LOG_LEVEL=INFO

# Optional: override the encryption key file for the local secret store.
CNKI_KEY_FILE=./data/keys/master.key

# Background worker concurrency defaults (overridable in UI settings)
CNKI_WORKER_CONCURRENCY=2
CNKI_AI_CONCURRENCY=1
